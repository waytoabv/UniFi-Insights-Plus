[Unit]
Description=UniFi Insights Plus - API and dashboard
Documentation=https://insightsplus.dev/docs
After=network-online.target postgresql.service uip-receiver.service
Wants=network-online.target

# Rate-limit restart loops. These are [Unit] keys — systemd ignores them
# in [Service] and says so in the journal.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=uip
Group=uip
WorkingDirectory=/app
EnvironmentFile=/etc/unifi-insights-plus.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/app/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# uip-api-start.sh derives UVICORN_LOG_LEVEL from LOG_LEVEL — the systemd
# equivalent of the `tr '[:upper:]' '[:lower:]'` step in entrypoint.sh.
ExecStart=/app/uip-api-start.sh

Restart=always
RestartSec=5

# See uip-receiver.service — /tmp is a shared IPC channel between the two units.
PrivateTmp=false
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uip-api

[Install]
WantedBy=multi-user.target
